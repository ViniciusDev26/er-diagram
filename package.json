{
  "name": "erdraw",
  "version": "5.0.0",
  "private": true,
  "description": "Draws the Mermaid ER diagram of a PostgreSQL or MySQL database",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sugomi-dev/erdraw.git"
  },
  "homepage": "https://github.com/sugomi-dev/erdraw#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --legal-comments=none --outfile=dist/index.cjs",
    "check": "biome check . && tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "mysql2": "^3.24.6",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@testcontainers/mysql": "^12.2.2",
    "@testcontainers/postgresql": "^12.2.2",
    "@types/node": "^26.6.11",
    "@vitest/coverage-v8": "^5.1.2",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "mermaid": "^12.3.0",
    "testcontainers": "^12.2.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "cpu-features": false,
    "esbuild": false,
    "protobufjs": false,
    "ssh2": false
  }
}
